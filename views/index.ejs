  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const viewCvBtn = document.getElementById('view-cv-btn');
    if (viewCvBtn) {
      viewCvBtn.addEventListener('click', () => {
        const link = document.createElement('a');
        link.href = 'https://drive.google.com/file/d/1nVeZzu03R4XJc-WdSxaXGQ_kbvaDcvQs/view?usp=sharing';
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
    }

    const downloadCvBtn = document.getElementById('download-cv-btn');
    if (downloadCvBtn) {
      downloadCvBtn.addEventListener('click', () => {
        const link = document.createElement('a');
        link.href = 'https://drive.google.com/uc?export=download&id=1nVeZzu03R4XJc-WdSxaXGQ_kbvaDcvQs';
        link.download = 'Joseph_Tabele_CV_2026.pdf';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
    }

    const showMoreProjectsBtn = document.getElementById('show-more-projects');
    const additionalProjects = document.querySelectorAll('.additional-project');
    if (showMoreProjectsBtn && additionalProjects.length) {
      showMoreProjectsBtn.addEventListener('click', () => {
        const isExpanded = showMoreProjectsBtn.getAttribute('aria-expanded') === 'true';
        additionalProjects.forEach((project) => {
          project.hidden = isExpanded;
        });
        showMoreProjectsBtn.setAttribute('aria-expanded', String(!isExpanded));
        showMoreProjectsBtn.textContent = isExpanded ? 'Show more' : 'Show less';
      });
    }
  });
  </script>
